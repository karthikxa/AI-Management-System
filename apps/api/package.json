{
  "name": "zed-api",
  "version": "1.0.0",
  "description": "Zed API - Unified monolith combining router, billing, platform, cron, and daytona-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run --ignore=MISSING_ENV_FILE -f .env.local -f .env -- bun run --hot src/index.ts",
    "dev:dev-env": "dotenvx run --overload -f .env.dev -- bun run --hot src/index.ts",
    "dev:staging-env": "dotenvx run --overload -f .env.staging -- bun run --hot src/index.ts",
    "dev:prod-env": "dotenvx run --overload -f .env.prod -- bun run --hot src/index.ts",
    "dev:envfile": "bun --env-file=.env.local run --hot src/index.ts",
    "start": "dotenvx run -- bun run src/index.ts",
    "e2e:flow": "bun run scripts/e2e-managed-flow.ts",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/test.sh",
    "test:coverage": "COVERAGE=1 bash scripts/test.sh",
    "test:integration": "bash scripts/test.sh integration",
    "test:live": "bash scripts/test.sh live",
    "test:all": "bash scripts/test.sh && bash scripts/test.sh integration"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.184.0",
    "@hono/zod-openapi": "^0.19.10",
    "@zed/api-contract": "workspace:*",
    "@zed/db": "workspace:*",
    "@zed/llm-catalog": "workspace:*",
    "@zed/llm-gateway": "workspace:*",
    "@zed/manifest-schema": "workspace:*",
    "@zed/registry": "workspace:*",
    "@zed/shared": "workspace:*",
    "@zed/starter": "workspace:*",
    "@logtail/node": "^0.5.8",
    "@scalar/hono-api-reference": "^0.10.20",
    "@sentry/bun": "^10.47.0",
    "@supabase/supabase-js": "^2.95.3",
    "agent-tunnel": "workspace:@zed/agent-tunnel@*",
    "croner": "^9.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "e2b": "2.37.0",
    "hono": "^4.4.0",
    "jose": "^5.9.6",
    "livekit-server-sdk": "^2.17.0",
    "postgres": "^3.4.8",
    "re2js": "2.8.6",
    "smol-toml": "^1.6.1",
    "stripe": "^14.0.0",
    "tar": "7.5.21",
    "yaml": "^2.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@zed/sdk": "workspace:*",
    "@types/bun": "^1.3.12",
    "bun-types": "^1.3.12",
    "typescript": "^5.4.0"
  }
}
